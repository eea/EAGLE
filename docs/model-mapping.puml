@startuml
skinparam packageStyle rectangle

title Model-Driven Transformation (XML & RDF)

package "Source: EAGLE" #LightBlue {
    [EAGLE UML Model] as EUML
    file "Source.xml" as SXML
}

package "The Semantic Bridge" #Gold {
    component "SSSOM Mapping Table" as SSSOM
    note bottom: Maps EAGLE Concepts \nto ISO Concepts
}

package "Target: ISO/INSPIRE" #LightGreen {
    [ISO UML Model] as IUML
    file "Target.xml" as TXML
    file "KnowledgeGraph.rdf" as RDF
}

'--- Transformations ---
EUML --> SSSOM : "Describes"
SSSOM --> IUML : "Links to"

SXML ..> IUML : "Ingested via Model"
IUML --> TXML : "Auto-generated Serialization"
IUML --> RDF : "Auto-generated Serialization"

@enduml