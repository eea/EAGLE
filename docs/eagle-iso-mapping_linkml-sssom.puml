@startuml eagle-iso-mapping_linkml-sssom
skinparam handwritten false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Arial"

title UBA Semantic Up-Ramp: Field Data to EAGLE/ISO Workflow

header Environment Agency Austria (UBA) - Technical Proposal 2026

actor "Field Biologist" as Bio
node "Pragmatic Layer" {
    file "field_data.csv" as CSV #LightGreen
}

package "Semantic Intermediary Layer (Logic-as-Metadata)" #LightBlue {
    component "LinkML Schema" as Schema <<YAML>>
    component "SSSOM Mapping" as SSSOM <<TSV>>
    
    note right of Schema
        **Validation & Identity**
        Binds CSV columns to
        Darwin Core / URIs
    end note
    
    note right of SSSOM
        **Semantic Decomposition**
        Maps Field Terms to 
        EAGLE LCC Codes (e.g., LCC_212)
    end note
}

package "Automated Processing" #GhostWhite {
    component "LinkML Validator" as Validator
    component "Semantic Harmonizer" as Harmonizer
}

node "Standards Layer (EEA/INSPIRE)" #Wheat {
    database "ISO 19115 Metadata" as ISO
    database "OGC API Features" as OGC
    database "EAGLE LCC Dataset" as EAGLE
}

'--- Workflow Connections ---

Bio -> CSV : "Sample Gathering"
CSV -> Validator : "Input"
Schema -> Validator : "Rules"

Validator -> Harmonizer : "Validated JSON-LD"
SSSOM -> Harmonizer : "Mapping Logic"

Harmonizer --> ISO : "Lifts to"
Harmonizer --> OGC : "Serves as"
Harmonizer --> EAGLE : "Decomposes to"

legend bottom
|= Color |= Layer |
| <#LightGreen> | Research / Field Entry |
| <#LightBlue> | Executable Metadata (The Proposal) |
| <#Wheat> | Formal European Standards |
endlegend

@enduml
